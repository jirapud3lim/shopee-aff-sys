# Copy to .env and fill in locally. Never commit .env or paste values into chat/logs.

# --- Meta (Facebook Login for Business, app in Development Mode) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v27.0
# Meta allows loopback HTTP automatically in Development Mode. For other callbacks, register the exact HTTPS URI.
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connections/meta/callback
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_engagement,pages_read_user_content
# Optional: Facebook Login for Business configuration id (used instead of scope when set)
# META_LOGIN_CONFIG_ID=
# Facebook Page for the live spike and the local Studio connection
META_TEST_PAGE_ID=
# Set the Studio workspace ID to restrict Page access to its owner.
META_STUDIO_WORKSPACE_ID=
META_STUDIO_PAGE_NAME=
META_STUDIO_EXAMPLE_REEL_ID=
META_STUDIO_PUBLISH_ENABLED=false
CAMPAIGN_LIVE_ENABLED=false
# Supplied by the OAuth spike's studio command, or injected by the server environment.
META_PAGE_ACCESS_TOKEN=
# Optional CA bundle path for Meta HTTPS requests.
META_CA_FILE=

# --- Shopee Affiliate Open API (TH) — only after approval ---
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
# Set the approved account's Studio workspace UUID to enable link generation for its owner.
SHOPEE_AFFILIATE_WORKSPACE_ID=
# Optional non-API mode. Set only for an Affiliate ID eligible for Shopee partner link wrapping.
SHOPEE_AFFILIATE_PARTNER_ID=
SHOPEE_AFFILIATE_API_URL=https://open-api.affiliate.shopee.co.th/graphql

# --- Security ---
# Key for encrypting provider tokens at rest, e.g. output of:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=
# Random secret for OAuth state/CSRF signing
OAUTH_STATE_SECRET=

# --- Infrastructure (Phase 1+, local Docker defaults) ---
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/affiliate
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=affiliate-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Media ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
