{
  "manifest_version": 3,
  "name": "Affiliate Studio Capture",
  "version": "0.4.0",
  "description": "Collect Shopee offers and links and exchange still storyboards with Google Flow for local Studio.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://shopee.co.th/*",
    "https://www.google.com/*",
    "https://www.google.co.th/*",
    "https://affiliate.shopee.co.th/*",
    "https://flow.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "studio.js",
        "flow-studio.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://shopee.co.th/*"
      ],
      "js": [
        "shopee.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.th/search*"
      ],
      "js": [
        "google.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://flow.google.com/project/*"],
      "js": ["flow-upload.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://flow.google.com/project/*"],
      "js": ["flow.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://affiliate.shopee.co.th/offer/product_offer*"
      ],
      "js": [
        "offers.js",
        "affiliate.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://affiliate.shopee.co.th/offer/custom_link*"],
      "js": ["affiliate.js"],
      "run_at": "document_idle"
    }
  ]
}
